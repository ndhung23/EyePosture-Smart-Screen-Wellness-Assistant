# EyePosture Environment Configuration Template

# Server & Cloud
PORT=8080
WINDOWS_DOWNLOAD_URL=https://github.com/ndhung23/EyePosture-Smart-Screen-Wellness-Assistant/releases/latest/download/EyePosture.exe

# Database & Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key

# Payment & Webhooks
MERCHANT_ID=your_merchant_id
SECRET_KEY=your_secret_key
SEPAY_WEBHOOK_SECRET=your_webhook_secret

# ========================================================
# CẤU HÌNH GỬI EMAIL (SMTP) - QUÊN MẬT KHẨU & THÔNG BÁO
# (Chỉ cần điền thông tin email của bạn vào đây khi cần gửi thực tế)
# ========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="EyePosture Assistant" <your_email@gmail.com>
